{
	"name": "DF_EnrichOrders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_factOrders",
						"type": "DatasetReference"
					},
					"name": "AllOrders"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_Customers",
						"type": "DatasetReference"
					},
					"name": "customer"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_products",
						"type": "DatasetReference"
					},
					"name": "product"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_SQL_factOrders",
						"type": "DatasetReference"
					},
					"name": "LoadEnrichOrder"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "OrderswithProfit"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          CustomerName as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          OrderMonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          DiscountPct as decimal(5,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostOfGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          IsDelivered as boolean,",
				"          Region as string,",
				"          LoadedAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> AllOrders",
				"source(output(",
				"          CustomerId as string,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Phone as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          CustomerSegment as string,",
				"          JoinDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> customer",
				"source(output(",
				"          ProductId as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          SubCategory as string,",
				"          Brand as string,",
				"          UnitPrice as integer,",
				"          CostPrice as integer,",
				"          StockQty as integer,",
				"          Supplier as string,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> product",
				"AllOrders, customer join(AllOrders@CustomerId == customer@CustomerId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, product join(AllOrders@ProductId == product@ProductId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 derive(CostofGoods = Quantity * CostPrice,",
				"          GrossProfit = NetRevenue - (Quantity * CostPrice),",
				"          ProfitMarginPct = (NetRevenue - Quantity * CostPrice) / 100) ~> OrderswithProfit",
				"OrderswithProfit select(mapColumn(",
				"          OrderId,",
				"          CustomerId = AllOrders@CustomerId,",
				"          ProductId = AllOrders@ProductId,",
				"          CustomerName,",
				"          ProductName = product@ProductName,",
				"          Category = product@Category,",
				"          OrderDate,",
				"          OrderMonth,",
				"          OrderYear,",
				"          Quantity,",
				"          UnitPrice = AllOrders@UnitPrice,",
				"          DiscountPct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          NetRevenue,",
				"          CostOfGoods = OrderswithProfit@CostofGoods,",
				"          GrossProfit,",
				"          PaymentMethod,",
				"          OrderStatus,",
				"          IsDelivered,",
				"          Region,",
				"          LoadedAt,",
				"          CustomerId = customer@CustomerId,",
				"          FirstName,",
				"          LastName,",
				"          Email,",
				"          Phone,",
				"          City,",
				"          State,",
				"          Country,",
				"          CustomerSegment,",
				"          JoinDate,",
				"          ProductId = product@ProductId,",
				"          ProductName = product@ProductName,",
				"          Category = product@Category,",
				"          SubCategory,",
				"          Brand,",
				"          UnitPrice = product@UnitPrice,",
				"          CostPrice,",
				"          StockQty,",
				"          Supplier,",
				"          IsActive,",
				"          CostofGoods = OrderswithProfit@CostofGoods,",
				"          ProfitMarginPct",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          CustomerName as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          OrderMonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          DiscountPct as decimal(5,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostOfGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          IsDelivered as boolean,",
				"          Region as string,",
				"          LoadedAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['truncate table fact_orders'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          OrderId,",
				"          CustomerId,",
				"          ProductId,",
				"          CustomerName,",
				"          ProductName,",
				"          Category,",
				"          OrderDate,",
				"          OrderMonth,",
				"          OrderYear,",
				"          Quantity,",
				"          UnitPrice,",
				"          DiscountPct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          NetRevenue,",
				"          CostOfGoods = {select1@CostOfGoods},",
				"          GrossProfit,",
				"          PaymentMethod,",
				"          OrderStatus,",
				"          IsDelivered,",
				"          Region",
				"     )) ~> LoadEnrichOrder"
			]
		}
	}
}